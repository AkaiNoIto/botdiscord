# Token du bot Discord (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Application ID de ton bot (Discord Developer Portal > General Information)
CLIENT_ID=

# ID de ton unique serveur Discord (clic droit sur le serveur > Copier l'identifiant)
GUILD_ID=

# Optionnel : active la commande /ask avec une vraie IA (sinon réponse générique)
OPENAI_API_KEY=
